                <mxCell id="b2_ttl" value="B-2 自律行動（ボイス/ステージでの配信）― autonomous_service.py（見回り・停止）＋ autonomous_speech.py（発話）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;fontFamily=Meiryo UI;" parent="1" vertex="1">
