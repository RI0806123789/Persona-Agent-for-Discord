                </mxCell>
                <mxCell id="a1_ext_edge" value="&lt;b&gt;edge-tts（主エンジン）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Microsoft Edge のニューラル音声&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ペルソナごとに話者/高さ/速さを変える&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
