                <mxCell id="a1_core_state" value="&lt;b&gt;BotState / GuildSettings&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(core/app_state.py)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※設定はサーバー単位。DM は全DM共有スロット&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
