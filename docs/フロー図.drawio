                <mxCell id="a2_ttl" value="A-2 メッセージ受信〜応答のワークフロー（1回のメンション発言）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="a2_u_send" value="&lt;b&gt;① @ボット でメンション発言&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;（画像 / pdf・txt・csv・md の添付も可）&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="260" y="150" width="210" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a2_u_recv" value="&lt;b&gt;⑬ 返信を受け取る&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テキストの返信は読み上げない（声の会話は /join の Gemini Live）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;必要なら 👍👎 を押す&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="150" width="210" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="a2_d_event" value="&lt;b&gt;Gateway: MESSAGE_CREATE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(discord.py)&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="260" y="310" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2_d_history" value="&lt;b&gt;REST: チャンネル履歴を取得&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(fetch_channel_history_text)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;HISTORY_LIMIT=100 件&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="310" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2_d_reply" value="&lt;b&gt;REST: 返信を送信&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(send_long_reply)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;2000字超は分割・戻り値は1通目&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="310" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2_d_voice" value="&lt;b&gt;ボイス送出 &amp;amp; リアクション付与&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;discord.PCMAudio / add_reaction ×2&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="310" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_mark" value="&lt;b&gt;関門② ブロック判定 → 種別判定 → 活動を観測&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;blacklist.is_blocked()&lt;br&gt;is_supported_message_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;auto_topic.mark_activity()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.mark_activity()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="260" y="495" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_gate" value="&lt;b&gt;関門① 応答モードのゲート&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DM / 全発言モード / メンション&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;or 配信中のコメント欄&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="510" y="495" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_mod" value="&lt;b&gt;通常会話・配信コメントは先に受付枠を確保&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;枠なしなら画像読込・API を呼ばず終了&lt;/span&gt;&lt;br&gt;&lt;b&gt;関門④ 統合判定を await&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;moderator.check_and_route()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;「サブエージェント」明記時は委任判定も&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="760" y="495" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_route" value="&lt;b&gt;関門⑤⑥ リマインダー・配信中かの取り直し&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ルーティング分岐（文書/コメント/委任/通常）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※統計記録は関門ではなく spawn される付随処理&lt;br&gt;委任は _handle_agent_request → C-3&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="495" width="210" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_handle" value="&lt;b&gt;handle_chat_message()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;channel.typing() 開始&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;画像は枚数・圧縮量・元寸法・形式別画素数を制限&lt;br&gt;JPEG縮小デコード → 長辺2048px以下 → RGB合計を制限&lt;br&gt;記憶は非同期一括取得（JSONは1回）&lt;br&gt;本文が空なら定型の質問文へ差し替え（画像も読めなければ断って終了）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="495" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_tts" value="&lt;b&gt;通常チャットは読み上げない（#268）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;play_tts_response は配信コメントへの応答だけ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="495" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_guard" value="&lt;b&gt;関門③ NGワード&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;ng_filter.contains_ng_word()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※①と③の間に 空判定（チャンネル種別は②の直後）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="510" y="655" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_prompt" value="&lt;b&gt;1本のフラットなプロンプトを組み立て&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;build_full_prompt()（services/prompting.py）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ペルソナ＋親密度＋記憶＋履歴＋質問&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="655" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_b_screen" value="&lt;b&gt;最後の感情タグを採用・タグを除去&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;extract_affinity_changes()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;→ screen_bot_response()（NGマスク＋AI判定）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※参考リンクは送信用テキストにだけ追記&lt;br&gt;（TTS・記憶・戻り値には含めない）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="655" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="a2_s_memory" value="&lt;b&gt;MemoryService.build_context()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;build_document_memory_context()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※そのユーザーのスライスだけ読む&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A4A00;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="845" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_s_gemini" value="&lt;b&gt;GeminiService.generate()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;共有SDKの aio.models.generate_content&lt;br&gt;検索ON → google_search ツール&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;検索非対応4xx・検索の429だけサブモデル検索→選択モデル非検索へ&lt;br&gt;全段で締切共有・障害時の暗黙リトライなし&lt;br&gt;本文に内部形式（tool_code・thought）が混入したら&lt;br&gt;破棄して同条件で再生成（上限あり）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A4A00;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="845" width="210" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="a2_s_feedback" value="&lt;b&gt;FeedbackService.track_reply()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※登録は同期・付与だけ spawn&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;60秒クールダウンで付与を間引く&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※登録の失敗はログだけ（記憶へ進む）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A4A00;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="845" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="a2_s_affinity" value="&lt;b&gt;AffinityService.build_dynamic_prompt()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;親密度・感情ブロックを生成&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A4A00;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="1005" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_s_usage" value="&lt;b&gt;UsageTracker.log_snapshot()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※インメモリ500件のリングバッファ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#7A4A00;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="1005" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_g_mod" value="&lt;b&gt;【1回目】統合判定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;モデレーション＋記憶ルーティング&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;＋リマインダー抽出（3判定を1回に統合）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※本文が空（画像のみ）なら呼ばれない＝Gemini は2回&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1170" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a2_g_main" value="&lt;b&gt;【2回目】本文生成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;→ (text, usage_metadata, grounding_sources)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="1170" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_g_screen" value="&lt;b&gt;【3回目】Bot応答モデレーション&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;direction=&quot;Bot応答&quot;（NGワードは渡さない）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="1170" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_stats" value="&lt;b&gt;spawn: stats.record()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;会話統計の記録（opt-out 判定はサービス内部）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="1355" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_affinity" value="&lt;b&gt;spawn: affinity.save_background(user_id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;対象ユーザーの保存を直列化&lt;br&gt;worker完了までロックを保持&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="1355" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_react" value="&lt;b&gt;spawn: 👍👎 リアクション付与&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;feedback._add_reactions()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="1355" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_doc" value="&lt;b&gt;文書添付 → キューへ登録（await）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;受付を返信 → 常駐ワーカーが回答&lt;br&gt;設定を固定し全要約をNGマスク・AI安全確認&lt;br&gt;ファイル回収後に未保存要約から返信生成&lt;br&gt;返信も安全なら一括保存・重複除去&lt;br&gt;sending保存から送信・完了まで中断を保護&lt;br&gt;送信結果不明なら再起動で再送しない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="1520" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_flush" value="&lt;b&gt;spawn: memory.flush_if_needed()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;記憶圧縮・各ユーザーの最新ログで待機判定&lt;br&gt;読込・保存の失敗は原データを残して後続へ、連続失敗時は次回へ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="1520" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_a_tts" value="&lt;b&gt;spawn: _run_speech_worker()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;edge-tts →(失敗時 gTTS)→ miniaudio → PCM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ギルド別キュー・接続別の再生ロック&lt;br&gt;接続先を合成前・再生前に照合&lt;br&gt;停止後もスレッド終了を待ってPCM解放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="2010" y="1520" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2_p_stats" value="&lt;b&gt;user_stats の対象1行を UPSERT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;stats_save_user(user_id, entry)&lt;br&gt;他ユーザーの行には触れない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="1685" width="210" height="100" as="geometry"/>
