                </mxCell>
                <mxCell id="b2_start" value="&lt;b&gt;autonomous_loop（1分ごと）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;run_pending_checks()&lt;/span&gt;&lt;br&gt;全サーバーを走査（DM は対象外）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;1サーバーの失敗で他を止めない&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="80" width="400" height="110" as="geometry"/>
                </mxCell>
