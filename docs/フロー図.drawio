                <mxCell id="a1_ext_discord" value="&lt;b&gt;Discord API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Gateway（イベント）＋ REST（送信）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;＋ ボイス接続（DAVE / Opus）&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
