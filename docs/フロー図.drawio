    <diagram id="pageB1" name="B-1 on_message パイプライン">
        <mxGraphModel dx="1075" dy="843" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="b1_ttl" value="B-1 on_message パイプライン（6段階の関門）― message_admission → message_routing → message_response" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="10" width="1800" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="b1_start" value="&lt;b&gt;on_message 受信&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="60" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_bot" value="&lt;b&gt;client.user が未確定（ログイン前）&lt;br&gt;または送信者がボットか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="180" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_resolve" value="&lt;b&gt;サーバー設定を解決&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;guild_id = message.guild.id if message.guild else None&lt;br&gt;await state.get_guild_async(guild_id)&lt;br&gt;未登録・再参加はDBの設定と記念日記録を復元&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※DM は全DM共有スロット&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="660" width="380" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="b1_mark" value="&lt;b&gt;会話の活動を観測（ブロック・種別判定の後、ゲートより前）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;auto_topic.mark_activity()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.mark_activity()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※ボット宛てでない発言も記録する&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="815" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_reopen" value="&lt;b&gt;閉じた作業スレッドの再開か確かめる（#408）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;_agent_work_threads.take_reopened()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;再開なら追加の依頼を定型文で1回だけ確認（LLM なし）&lt;br&gt;確認後もボット宛てなら下の関門を通常どおり通る&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="960" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_gate" value="&lt;b&gt;関門① 応答モードのゲート&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;accepts_normally?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;DM / mention以外のモード / メンションあり&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1100" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_comment" value="&lt;b&gt;【例外】配信中のコメント欄か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.is_comment_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※メンション不要で拾う&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1290" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_vc_chat" value="&lt;b&gt;接続中の通話のチャットか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;is_connected_voice_chat()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※判定のたびに guild.voice_client を見る&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1275" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b1_vc_ng" value="&lt;b&gt;ローカルの NG 判定だけ行う&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;_reject_ng_input()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※AI 判定・返信・統計は行わない（#172）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1470" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_black" value="&lt;b&gt;関門② ブラックリスト（最初に判定）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;blacklist.is_blocked()&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="340" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_empty" value="&lt;b&gt;本文をクリーニングした結果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;clean_message_content()&lt;/span&gt;&lt;br&gt;&lt;b&gt;本文も添付も空か?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1470" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_channel" value="&lt;b&gt;返信・履歴取得ができる種別か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;is_supported_message_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※設定解決・活動観測・NG判定・Gemini より前に打ち切る&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="490" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_ng" value="&lt;b&gt;関門③ NGワードフィルタ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;ng_filter.contains_ng_word()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※本文があるときだけ判定する&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1650" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_mod" value="&lt;b&gt;通常会話は入力AI・画像読込前に受付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;満杯は期間内1回の案内 → return、実行枠は finally で返却&lt;/span&gt;&lt;br&gt;&lt;b&gt;画像のみのコメントも枠確保 → 読込確認&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;画像が空でも配信終了後なら通常の添付経路へ&lt;br&gt;受付前に配信終了 → 通常会話へ戻し、委任判定も行う&lt;/span&gt;&lt;br&gt;&lt;b&gt;関門④ 入力判定を Gemini 1回で&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;check_and_route() / サブエージェント明記時は check_route_and_plan()&lt;br&gt;本文ありのみ / 例外・タイムアウト・JSON失敗は safe&lt;br&gt;安全フィルタ・テキスト取得失敗は unsafe&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1830" width="380" height="195" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_safe" value="&lt;b&gt;is_safe ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="2075" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_conn_a" value="&lt;b&gt;①&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="2225" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_ignore_bot" value="&lt;b&gt;return（黙って破棄）&lt;/b&gt;&lt;br&gt;・未ログイン / ボットの発言&lt;br&gt;・ブラックリスト登録済み（活動も記録しない）&lt;br&gt;・返信・履歴取得ができないチャンネル種別" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="155" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b1_ignore" value="&lt;b&gt;黙って破棄（return）&lt;/b&gt;&lt;br&gt;・ゲート不成立で配信中でもない（接続中の通話のチャットは NG 判定の後）&lt;br&gt;・本文も添付も空" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1630" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b1_violation" value="&lt;b&gt;notify_violation()&lt;/b&gt;&lt;br&gt;違反を1回記録し警告を返信&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;blacklist.record_violation()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;記録した回数をログに出す。保存に失敗した違反は数えず、&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;残り回数を付けない警告だけ返して終了（#173）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1830" width="300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_violation" value="&lt;b&gt;違反が3回目か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;BLACKLIST_MAX_VIOLATIONS = 3&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2000" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_blocked" value="&lt;b&gt;ブラックリストに登録&lt;/b&gt;&lt;br&gt;「以降のメッセージは無視されます」&lt;br&gt;と返信して終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2150" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_warn" value="&lt;b&gt;「あと◯回で応答を停止します」&lt;/b&gt;&lt;br&gt;と警告して終了&lt;br&gt;※並行した違反で既にブロック済みなら返信しない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2300" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_conn_b" value="&lt;b&gt;①&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="60" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_touch" value="&lt;b&gt;最終活動時刻を更新&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;state.touch()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※話題提供の監視（watch_channel）は、配信の再確認と&lt;br&gt;通常枠の確保が済んだ発言だけ（下の再確認で登録）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="190" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_attach" value="&lt;b&gt;添付ファイルの種別は?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（多分岐）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="880" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_stats" value="&lt;b&gt;spawn(stats.record(...))&lt;/b&gt;&lt;br&gt;会話統計を fire-and-forget で記録&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※opt-out 判定は StatsService の内部で行う&lt;br&gt;DB保存成功後だけキャッシュへ反映&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1070" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_reminder" value="&lt;b&gt;関門⑤ リマインダー依頼が&lt;br&gt;抽出されていたか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（関門④ の戻り値 reminder）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1240" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_reminder" value="&lt;b&gt;reminders.create_from_request()&lt;/b&gt;&lt;br&gt;日時の解釈・過去/上限の検証&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;REMINDER_MAX_PENDING_PER_USER = 20&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1410" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_reminder_ok" value="&lt;b&gt;確認文（戻り値）が返ったか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1570" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_recheck" value="&lt;b&gt;添付・統計・リマインダーより先に配信を再確認&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.is_comment_channel()&lt;br&gt;終了後は通常枠を確保（満杯は期間内1回の案内 → return）&lt;br&gt;通常会話だけ監視へ登録し、読込済み画像は空でも再利用&lt;br&gt;入口の判定を再利用しない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="350" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_comment2" value="&lt;b&gt;いま配信中か?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="540" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_normal" value="&lt;b&gt;accepts_normally ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（DM / 全発言モード / メンションあり）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="700" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_agent" value="&lt;b&gt;委任する依頼か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;agent_plan.delegate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（「サブエージェント」明記時に関門④で判定）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1730" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_agent" value="&lt;b&gt;_handle_agent_request()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(core/agent_request.py) ※詳細は C-3&lt;/span&gt;&lt;br&gt;実行枠を確保 → 進捗を表示&lt;br&gt;（作業スレッド ／ 使えなければ返信1通）&lt;br&gt;子が検索つきで最大3手順&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;報告と出典を NG マスク・AI 判定してから公開&lt;br&gt;返信できたら作業スレッドを閉じる（#408）&lt;/span&gt;" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="1720" width="340" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="b1_handle_chat" value="&lt;b&gt;handle_chat_message()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(core/message_response.py)&lt;/span&gt;&lt;br&gt;通常のチャット応答&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;応答の判定を通過し送信できた後に親密度・👍👎・記憶&lt;br&gt;送信の失敗だけ呼出元へ伝える&lt;/span&gt;" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1890" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_resp" value="&lt;b&gt;応答本文あり かつ&lt;br&gt;can_speak_session() ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;同じ配信・接続中・同じチャンネル&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="1950" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_tts" value="&lt;b&gt;読み上げない（#268）&lt;/b&gt;&lt;br&gt;テキストの返信は読み上げない&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※声の会話は /join の Gemini Live（C-1・C-2）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="2060" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_comment_tts" value="&lt;b&gt;play_tts_response()&lt;/b&gt;&lt;br&gt;配信の読み上げキューへ投入&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;投入前・合成前・再生前に配信と接続先を照合&lt;br&gt;→ audio/voice.py（A-2 の読み上げワーカー）&lt;/span&gt;" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="2100" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_end" value="&lt;b&gt;終了&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="2250" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_unsupported" value="&lt;b&gt;「未対応の添付ファイルが含まれています」と返信&lt;/b&gt;&lt;br&gt;対応形式（画像・pdf / txt / csv / md）を案内&lt;br&gt;→ 終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="880" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_oversize" value="&lt;b&gt;「ファイルサイズが上限を超えています」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;MAX_DOCUMENT_SIZE_BYTES = 5MB&lt;/span&gt;&lt;br&gt;→ 終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="1050" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_doc" value="&lt;b&gt;文書ワーカーへキュー登録&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;documents.enqueue_from_message()&lt;/span&gt;&lt;br&gt;「受付が完了しました」と返信&lt;br&gt;→ 常駐ワーカーが後で回答（非同期）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;未処理件数の上限なら DOCUMENT_QUEUE_FULL_NOTICE を返し&lt;br&gt;受付完了とは言わない（#202）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="1230" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="b1_reminder_ok" value="&lt;b&gt;確認文だけを返信して終了&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※同じ発言にチャット返信も返すと&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;二重投稿になるため&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="1570" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_handle_comment" value="&lt;b&gt;autonomous.handle_comment()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(services/autonomous_speech.py)&lt;/span&gt;&lt;br&gt;予約したセッションが現在も同じか確認&lt;br&gt;受付済みの枠は二重に確保しない&lt;br&gt;長期記憶・親密度・👍👎 は使わない&lt;br&gt;文書処理・リマインダー・通常統計も省略" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
