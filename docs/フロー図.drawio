                <mxCell id="a1_worker_doc" value="&lt;b&gt;文書処理ワーカー（常駐コルーチン）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;spawn(documents.run_worker())&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※参照を保持しないと GC で止まる&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
