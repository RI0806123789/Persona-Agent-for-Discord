                <mxCell id="a1_ext_gtts" value="&lt;b&gt;gTTS（退避エンジン）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;edge-tts が壊れたときの保険&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※この経路を消さないこと&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="450" y="960" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a1_mod_voice" value="&lt;b&gt;audio/voice.py / audio/voice_dsp.py（自律配信の読み上げ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;感情・親密度タグ除去 → ギルド別 読み上げキュー → miniaudio でメモリ上デコード → numpy バイクアッド EQ → 48kHz/2ch/16bit PCM（FFmpeg 不使用）&lt;/span&gt;&lt;br&gt;&lt;b&gt;audio/voice_receive.py / live_audio.py / echo_canceller.py（/join の音声会話）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;UDP受信 → 転送層・DAVE の復号 → Opus デコード → エコー除去（#409）→ 16kHz へ変換して Live へ／Live の 24kHz を 48kHz へ変換して再生&lt;/span&gt;" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1100" width="680" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="a1_db_sqlite" value="&lt;b&gt;data/memory/bot.db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SQLite（WAL モード）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;単一プロセス前提&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;threading.Lock で直列化&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;書き込みはトランザクション&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="870" y="820" width="250" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="a1_db_tables" value="&lt;b&gt;10 テーブル（SCHEMA_VERSION=15）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;① affinity 親密度・感情&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;② user_stats 会話統計&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;③ queue_tasks 文書処理キュー&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;④ pending_log 圧縮前ログ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑤ profile プロフィール記憶&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑥ guild_settings サーバー設定&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑦ anniversary_posts 記念日&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑧ reminders リマインダー&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑨ feedback 👍👎 の評価&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;⑩ legacy_imports 旧ファイルの取り込み記録&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;align=left;verticalAlign=middle;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="820" width="290" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="a1_json_projects" value="&lt;b&gt;data/memory/projects.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;LLM が構造を決める長期記憶&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;users[user_id] でユーザー別&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="820" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a1_json_profile" value="&lt;b&gt;data/memory/profile.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ASCII数字ID＋辞書のみユーザー別&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;取り込み成功時だけ原子的に {} へ戻す&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;取り込めない原本は警告して保持&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="940" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a1_json_blacklist" value="&lt;b&gt;data/ng/blacklist.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ブロック中ユーザー&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="1060" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a1_files_static" value="&lt;b&gt;静的ファイル（読み取り）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;prompts/*.txt・personas.json（ペルソナ。見本以外は gitignore）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;data/ng/NG_WORD.txt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;data/ng/NG_WORD_private.txt（gitignore）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;.env（APIキー・トークン）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="870" y="1030" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="a1_mem_only" value="&lt;b&gt;再起動で失われる状態（インメモリのみ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;利用トークン履歴(500件) / channel_reset_points / 自発会話の監視状態 / 自律行動の配信状態と話したいゲージ / 自律行動の開始失敗の待ち時間(start_failures / start_retry_at) / フィードバックの評価対象レジストリ・評価者ごとのリアクション状態・付与クールダウン記録 / ギルド別 TTS 読み上げキュー(voice._speech_queues) / welcomed_guild_ids / ボイス接続先の保護の意図した接続先(VoiceGuard._homes) / サブエージェントの実行中の依頼者・Webhook のキャッシュ・作業スレッドの記録 / 音声会話のセッション・同意・再開ハンドル・SSRC と話者の対応&lt;/span&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontColor=#7F6000;fontSize=11;fontFamily=Meiryo UI;align=left;spacingLeft=8;" parent="1" vertex="1">
