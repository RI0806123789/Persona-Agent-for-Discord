                    <mxGeometry x="710" y="370" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c2_floor" value="発話権は?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;" parent="1" vertex="1">
                    <mxGeometry x="360" y="480" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c2_hold" value="発話希望として覚える&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;最大3人・3秒／音声は溜めない&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="635" y="485" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c2_ff2" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="710" y="580" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c2_barge" value="ボットが返答中か?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;" parent="1" vertex="1">
                    <mxGeometry x="360" y="645" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c2_barge_act" value="割り込みの扱い（#409）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;再生中：2秒話し続けたら送り、&lt;br&gt;文字起こしで確定&lt;br&gt;生成待ち：500ms で前の返答を破棄&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="635" y="630" width="180" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c2_begin" value="_begin_activity()&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;発言を作り、activity_start と&lt;br&gt;判定前の先読み分を送る&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="310" y="780" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c2_send" value="音声を Live へ送り続ける&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;start／audio／end を1本の待ち行列で（_run_sender）&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="310" y="890" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c2_end" value="話し終わりか?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;" parent="1" vertex="1">
                    <mxGeometry x="360" y="1000" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c2_end_act" value="_end_activity()&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;activity_end を送り、待っていた人に優先権&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="310" y="1120" width="340" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="c2_note_rx" value="・ボットの声が出ている間も受信は止めない（#409）&lt;br&gt;・Live へ送るのは同時に1人分だけ&lt;br&gt;・発話の区切りはボット側の VAD で伝える&lt;br&gt;（サーバーの自動検出は使わない）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C9B458;fontColor=#4D4000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1300" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c2_fork" value="" style="rounded=0;html=1;fillColor=#1A1A1A;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1220" width="1670" height="8" as="geometry"/>
                </mxCell>
                <mxCell id="c2_region" value="中断可能な領域：割り込みの確定・違反の検出・一時停止・Live の張り替えで再生を止める" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#B85450;dashed=1;dashPattern=8 4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#7A1F1C;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="835" y="1250" width="770" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="c2_gen" value="Live が返答を生成&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;24kHz の音声と&lt;br&gt;入出力の文字起こしを返す&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;" parent="1" vertex="1">
