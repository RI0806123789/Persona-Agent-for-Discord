                <mxCell id="a1_ext_gemini" value="&lt;b&gt;Gemini API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;google-genai SDK&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;生成・検索・Filesを共有クライアントへ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;Live API（gemini-3.8-live）で /join の音声会話&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#333333;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
