                <mxCell id="a1_e10" value="チャット主経路は GuildSettings を引数で渡す&lt;br&gt;見回り系4サービス（Memory / Document / AutoTopic / Autonomous）は&lt;br&gt;全ギルド横断のため BotState 自体を受け取る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontFamily=Meiryo UI;labelBackgroundColor=#FFFFFF;strokeColor=#4D4D4D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.57;entryDx=0;entryDy=0;" parent="1" source="a1_core_state" target="a1_grp_services" edge="1">
