                <mxCell id="a1_ttl" value="A-1 システム全体構成と起動フロー ― Persona Agent for Discord" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="30" width="1000" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="a1_package_layout" value="起動は src/bot.py。各モジュールのパスは src/persona_bot/ 基準（config/・core/・services/・views/・audio/・utils/）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="80" width="1700" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="a1_start" value="&lt;b&gt;起動&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;python bot.py&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※ src/ の中から実行&lt;br&gt;最初に configure_logging()&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_settings" value="&lt;b&gt;① データ配置の確認 → 設定の読み込み&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(ensure_data_directory_ready → settings_loader.load_settings)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※旧 memory/・ng/ が残っていれば止める&lt;br&gt;ルート直下の .env → APIキー / トークン&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="270" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_genai" value="&lt;b&gt;② Gemini の初期化と intents の準備&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(genai_client.create_genai_client)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;intents: Intents.default() ＋ message_content / voice_states&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※guilds / reactions は default に含まれる&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="480" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_db" value="&lt;b&gt;③ Database 初期化 → クライアント生成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(Database.initialize → PersonaClient)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DDL＋版を原子的に移行 v15 / 旧JSON取り込み&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※移行は db_migrations.py、取り込みは db_legacy_importers.py&lt;br&gt;終了時は TaskOwner が受付・周期処理を停止&lt;br&gt;コマンド・背景処理等を回収後、DB を最後に閉じる&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="690" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_restore" value="&lt;b&gt;④ サーバー設定の復元&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(先に reload_persona_catalog → BotState.restore_from_database)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ペルソナ/モデル/モード/Google検索/&lt;br&gt;自発会話(ON・しきい値)/自律行動(ON・配信先)&lt;br&gt;＋ 記念日の投稿記録&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="900" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_services" value="&lt;b&gt;⑤ サービスを1つずつ生成し&lt;br&gt;手作業で相互注入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※DIフレームワークは使わない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_register" value="&lt;b&gt;⑥ スラッシュコマンド登録&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;(commands.register_commands)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/functions /join /leave&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;実行時・パネル操作時にブロック判定&lt;br&gt;参加・退出は VoiceCommandCoordinator（世代確認＋サーバー別ロック）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_ready" value="&lt;b&gt;⑦ client.run() → on_ready&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;tree.sync() / 各ループ start()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※再接続で再発火するため *_background_started /&lt;br&gt;document_worker_started / commands_synced で二重起動を防ぐ&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1530" y="110" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a1_core_bot" value="&lt;b&gt;bot.py（コンポジションルート）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;on_message → MessageHandler（受付→振り分け→応答）&lt;br&gt;on_ready / on_guild_join / on_guild_remove&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;on_raw_reaction_* / on_voice_state_update&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="305" width="280" height="85" as="geometry"/>
