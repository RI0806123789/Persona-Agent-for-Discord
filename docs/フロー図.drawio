                <mxCell id="a2_p_affinity" value="&lt;b&gt;affinity の対象1行を UPSERT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;親密度 / valence / arousal / last_interaction&lt;br&gt;他ユーザーの行には触れない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3A63;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
