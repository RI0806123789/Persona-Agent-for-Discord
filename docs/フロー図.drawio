                <mxCell id="c2_recv" value="音声フレームを受信&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;UDP → 復号（転送層・DAVE）→ Opus&lt;br&gt;→ エコー除去（#409）→ 16kHz&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Meiryo UI;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;" parent="1" vertex="1">
                    <mxGeometry x="310" y="225" width="340" height="70" as="geometry"/>
                </mxCell>
